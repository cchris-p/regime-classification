{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cchris-p/regime-classification/docs/regime-signal.schema.json",
  "title": "Online Regime Signal Contract (regime-partitioning-online-v1)",
  "description": "Read-only daily regime signal consumed by TJB-073. Required fields are stable; additional provenance fields may be added.",
  "type": "object",
  "required": [
    "as_of",
    "symbol",
    "regime",
    "p_states",
    "classifier_version",
    "fast_flag",
    "fast_reasons",
    "stale",
    "no_data"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Evaluation date (the signal is valid only for this date)."
    },
    "symbol": {"type": "string", "minLength": 1},
    "regime": {
      "type": "string",
      "enum": ["risk_on", "risk_off", "NO DATA"]
    },
    "p_states": {
      "type": "object",
      "required": ["risk_on", "risk_off"],
      "properties": {
        "risk_on": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "risk_off": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "classifier_version": {"type": "string", "minLength": 1},
    "fast_flag": {"type": "boolean"},
    "fast_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "stale": {"type": "boolean"},
    "no_data": {"type": "boolean"},
    "last_bar": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cadence": {"type": "string"},
    "generated_at": {"type": "string"}
  },
  "additionalProperties": true
}
